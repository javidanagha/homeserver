<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>

<group name="local,rootcheck,">
  <rule id="100100" level="0">
    <if_sid>510</if_sid>
    <match>Trojaned version of file</match>
    <regex type="pcre2">'/(usr/)?bin/(uname|md5sum|ls|env|echo|date|chown|chmod|chgrp|cat)'</regex>
    <description>Ignore rootcheck generic-signature FP on uutils coreutils</description>
  </rule>
</group>
