[Unit]
Description=Wazuh alerts -> Telegram
After=wazuh-manager.service network-online.target
Wants=network-online.target

[Service]
User=wazuhtg
Group=wazuh
EnvironmentFile=/etc/wazuh-telegram/bot.env
ExecStart=/usr/bin/python3 /usr/local/bin/wazuh-telegram.py
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
